<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="angel.tfg.pymeris.Views.Inicio.InicioController">
   <HBox alignment="CENTER">
      <ImageView fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
         <Image url="@../../Imagenes/Logo/Logo_128.png"/>
      </ImageView>
      <Label text="PYMERIS">
         <font>
            <Font name="System Bold Italic" size="150.0"/>
         </font>
      </Label>
   </HBox>
   <Region prefHeight="100.0" prefWidth="200.0"/>
   <Button alignment="CENTER" onAction="#goToLogin" contentDisplay="CENTER" mnemonicParsing="false" text="COMENZAR">
      <font>
         <Font size="75.0"/>
      </font>
   </Button>
   <Region prefHeight="200.0" prefWidth="200.0"/>
</VBox>
