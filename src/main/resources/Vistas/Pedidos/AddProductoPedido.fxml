<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="angel.tfg.pymeris.Views.ManageOrders.CreateOrder.AddProduct.AddProductController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="AÑADIR PRODUCTO" />
    <TableView fx:id="tvProducto">
        <columns>
            <TableColumn fx:id="colNombre" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" sortable="false" text="NOMBRE" />
            <TableColumn fx:id="colDescripcion" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" sortable="false" text="DESCRIPCIÓN" />
            <TableColumn fx:id="colPrecio" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" sortable="false" text="PRECIO" />
            <TableColumn fx:id="colStock" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" sortable="false" text="STOCK" />
        </columns>
    </TableView>
   <Label fx:id="lblStatus" />
    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Cantidad:" />
        <TextField fx:id="tfCantidad" alignment="CENTER" maxHeight="30.0" maxWidth="50.0" minHeight="30.0" minWidth="50.0" prefHeight="30.0" prefWidth="50.0">
            <font>
                <Font size="14.0" />
            </font>
        </TextField>
    </HBox>
    <HBox alignment="CENTER">
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#onCancel" text="Cancelar" />
        </VBox>
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#onAddProduct" text="Añadir" />
        </VBox>
    </HBox>
</VBox>
