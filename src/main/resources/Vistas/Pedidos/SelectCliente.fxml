<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="angel.tfg.pymeris.Views.ManageOrders.CreateOrder.SelectCliente.SelectClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="ELEGIR CLIENTE">
      <font>
         <Font size="18.0" />
      </font></Label>
    <TableView fx:id="tvCliente" maxHeight="400.0" maxWidth="452.0" minHeight="400.0" minWidth="452.0" prefHeight="400.0" prefWidth="452.0">
        <columns>
         <TableColumn fx:id="colDniNif" editable="false" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" sortable="false" text="DNI/NIF" />
            <TableColumn fx:id="colNombre" editable="false" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" sortable="false" text="NOMBRE" />
            <TableColumn fx:id="colApellido" editable="false" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" sortable="false" text="APELLIDO" />
        </columns>
    </TableView>
    <HBox alignment="CENTER">
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#onCancel" text="Cancelar" />
        </VBox>
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button mnemonicParsing="false" onAction="#onSelect" text="Seleccionar" />
        </VBox>
    </HBox>
</VBox>
