<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1"
      fx:controller="angel.tfg.pymeris.Views.ManageProducts.ModifyProduct.ModifyProductController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>
    <Label text="MODIFICAR PRODUCTO">
        <font>
            <Font size="36.0"/>
        </font>
    </Label>
    <VBox>
        <GridPane alignment="TOP_CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="80.0" minWidth="80.0"
                                   prefWidth="80.0"/>
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="200.0" minWidth="200.0"
                                   prefWidth="200.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="60.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
                <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="135.0" vgrow="ALWAYS"/>
            </rowConstraints>
            <Label text="ID PRODUCTO" GridPane.columnIndex="1" GridPane.halignment="LEFT">
                <GridPane.margin>
                    <Insets left="30.0" right="30.0"/>
                </GridPane.margin>
            </Label>
            <Label fx:id="lblID" alignment="TOP_LEFT" text="ID" GridPane.columnIndex="1" GridPane.halignment="RIGHT"
                   GridPane.hgrow="NEVER" GridPane.valignment="CENTER" GridPane.vgrow="NEVER">
                <GridPane.margin>
                    <Insets left="30.0" right="30.0"/>
                </GridPane.margin>
            </Label>
            <Label text="Nombre" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
                <GridPane.margin>
                    <Insets right="10.0"/>
                </GridPane.margin>
            </Label>
            <Label text="Categoría" GridPane.halignment="RIGHT" GridPane.rowIndex="2">
                <GridPane.margin>
                    <Insets right="10.0"/>
                </GridPane.margin>
            </Label>
            <Label text="Descripción" GridPane.halignment="RIGHT" GridPane.rowIndex="3">
                <GridPane.margin>
                    <Insets right="10.0"/>
                </GridPane.margin>
            </Label>
            <TextField fx:id="tfNombre" promptText="Nombre" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                       GridPane.hgrow="NEVER" GridPane.rowIndex="1" GridPane.valignment="CENTER"
                       GridPane.vgrow="NEVER"/>
            <TextField fx:id="tfCategoria" promptText="Categoría" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                       GridPane.hgrow="NEVER" GridPane.rowIndex="2" GridPane.valignment="CENTER"
                       GridPane.vgrow="NEVER"/>
            <TextArea fx:id="taDescripcion" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="100.0"
                      promptText="Descripción" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <GridPane.margin>
                    <Insets/>
                </GridPane.margin>
            </TextArea>
        </GridPane>
        <HBox alignment="CENTER" spacing="30.0">
            <VBox alignment="CENTER" spacing="3.0">
                <Label text="PRECIO"/>
                <TextField fx:id="tfPrecio" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                           minHeight="-Infinity" minWidth="-Infinity" prefHeight="35.0" prefWidth="85.0">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </TextField>
            </VBox>
            <VBox alignment="CENTER" spacing="3.0">
                <Label text="IVA"/>
                <TextField fx:id="tfIVA" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                           minHeight="-Infinity" minWidth="-Infinity" prefHeight="35.0" prefWidth="85.0">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </TextField>
            </VBox>
            <VBox alignment="CENTER" spacing="3.0">
                <Label text="STOCK"/>
                <TextField fx:id="tfStock" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                           minWidth="-Infinity" prefHeight="35.0" prefWidth="85.0">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </TextField>
            </VBox>
        </HBox>
    </VBox>
    <VBox alignment="CENTER" spacing="25.0">
        <Label fx:id="lblStatus"/>
        <Button fx:id="btnModify" mnemonicParsing="false" onAction="#onModifyProduct" text="MODIFICAR"/>
        <Button mnemonicParsing="false" onAction="#onCancel" text="CANCELAR"/>
    </VBox>
</VBox>
