<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.ToggleSwitch?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="angel.tfg.pymeris.Views.ManageUsers.ModifyUser.ModifyUserController">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="20.0"/>
    </padding>
    <Label text="MODIFICAR USUARIO">
        <font>
            <Font size="36.0"/>
        </font>
    </Label>
    <Label fx:id="lblNombre"/>
    <GridPane alignment="TOP_CENTER">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="80.0" minWidth="80.0" prefWidth="80.0"/>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="200.0" prefWidth="200.0"/>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="200.0" prefWidth="200.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="100.0" minHeight="35.0" prefHeight="60.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <Label text="ID" GridPane.columnIndex="1" GridPane.halignment="LEFT">
            <GridPane.margin>
                <Insets left="30.0" right="30.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Nombre" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Apellido" GridPane.halignment="RIGHT" GridPane.rowIndex="2">
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Correo" GridPane.halignment="RIGHT" GridPane.rowIndex="3">
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Teléfono" GridPane.halignment="RIGHT" GridPane.rowIndex="4">
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Usuario" GridPane.halignment="RIGHT" GridPane.rowIndex="5">
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label fx:id="lblID" alignment="TOP_LEFT" text="ID" GridPane.columnIndex="1" GridPane.halignment="RIGHT"
               GridPane.hgrow="NEVER" GridPane.valignment="CENTER" GridPane.vgrow="NEVER">
            <GridPane.margin>
                <Insets left="30.0" right="30.0"/>
            </GridPane.margin>
        </Label>
        <TextField fx:id="tfNombre" promptText="Nombre" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                   GridPane.hgrow="NEVER" GridPane.rowIndex="1" GridPane.valignment="CENTER"
                   GridPane.vgrow="NEVER"/>
        <TextField fx:id="tfApellido" promptText="Apellido" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                   GridPane.hgrow="NEVER" GridPane.rowIndex="2" GridPane.valignment="CENTER"
                   GridPane.vgrow="NEVER"/>
        <TextField fx:id="tfCorreo" promptText="Correo" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                   GridPane.hgrow="NEVER" GridPane.rowIndex="3" GridPane.valignment="CENTER"
                   GridPane.vgrow="NEVER"/>
        <TextField fx:id="tfTelefono" promptText="Teléfono" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                   GridPane.hgrow="NEVER" GridPane.rowIndex="4" GridPane.valignment="CENTER"
                   GridPane.vgrow="NEVER"/>
        <TextField fx:id="tfUsuario" promptText="Usuario" GridPane.columnIndex="1" GridPane.halignment="LEFT"
                   GridPane.hgrow="NEVER" GridPane.rowIndex="5" GridPane.valignment="CENTER"
                   GridPane.vgrow="NEVER"/>
        <ToggleSwitch fx:id="tsAdmin" alignment="CENTER_RIGHT" contentDisplay="RIGHT" text="ADMIN" viewOrder="1.0"
                      GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="2"/>
        <ToggleSwitch fx:id="tsEstado" alignment="CENTER_RIGHT" contentDisplay="RIGHT" selected="true" text="ESTADO"
                      viewOrder="1.0" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4"/>
    </GridPane>
    <VBox alignment="CENTER" spacing="40.0">
        <Label fx:id="lblStatus"/>
        <Button fx:id="btnModify" mnemonicParsing="false" text="MODIFICAR" onAction="#onModifyUser"/>
        <Button mnemonicParsing="false" text="CANCELAR" onAction="#onCancel" />
    </VBox>
</VBox>
